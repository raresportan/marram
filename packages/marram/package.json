{
  "name": "@raresportan/marram",
  "version": "0.2.3",
  "description": "The gate, ratchet lints and journeys that keep agent-written code from drifting.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raresportan/marram.git",
    "directory": "packages/marram"
  },
  "files": ["src/**/*.mjs", "src/**/*.js", "src/**/*.d.ts", "src/**/*.d.mts", "bin"],
  "bin": {
    "marram": "bin/marram.mjs"
  },
  "exports": {
    "./core/run": "./src/core/run.mjs",
    "./core/feature-map": "./src/core/feature-map.mjs",
    "./core/journey-lint": "./src/core/journey-lint.mjs",
    "./core/boundaries": "./src/core/boundaries.mjs",
    "./core/check-lint": "./src/core/check-lint.mjs",
    "./core/no-comments": "./src/core/no-comments.mjs",
    "./core/ratchet": "./src/core/ratchet.mjs",
    "./core/until": { "types": "./src/core/until.d.ts", "default": "./src/core/until.js" },
    "./node/background": { "types": "./src/node/background.d.ts", "default": "./src/node/background.js" },
    "./node/promise-lint": "./src/node/promise-lint.mjs",
    "./node/resource-lint": "./src/node/resource-lint.mjs",
    "./node/scope": { "types": "./src/node/scope.d.ts", "default": "./src/node/scope.js" },
    "./react/effect-lint": "./src/react/effect-lint.mjs",
    "./react/keyed": { "types": "./src/react/keyed.d.ts", "default": "./src/react/keyed.js" },
    "./electron/feature-map": { "types": "./src/electron/feature-map.d.ts", "default": "./src/electron/feature-map.js" },
    "./electron/frames": { "types": "./src/electron/frames.d.ts", "default": "./src/electron/frames.js" },
    "./electron/geometry": { "types": "./src/electron/geometry.d.ts", "default": "./src/electron/geometry.js" },
    "./electron/journey-lint": "./src/electron/journey-lint.mjs",
    "./electron/run": { "types": "./src/electron/run.d.ts", "default": "./src/electron/run.js" },
    "./electron/ipc": { "types": "./src/electron/ipc.d.ts", "default": "./src/electron/ipc.js" },
    "./electron/session": { "types": "./src/electron/session.d.ts", "default": "./src/electron/session.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "playwright-core": "*",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "playwright-core": { "optional": true },
    "react": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  }
}
